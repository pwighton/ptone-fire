*.h5 filter=lfs diff=lfs merge=lfs -text

# Line endings: all text files are stored and checked out with Unix (LF) line endings
* text=auto eol=lf
# Windows batch files need Windows (CRLF) line endings
*.bat text eol=crlf
# The FIRE scanner config files go on the Windows scanner: keep them byte-for-byte (CRLF), never convert
ptone/scanner-config/** -text
